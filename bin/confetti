#!/bin/bash
# Trigger confetti in the Confetti menu bar app from the command line.
#
# Usage: confetti [--silent|--sound]
#   --silent   fire without the party sound, regardless of the app setting
#   --sound    fire with the party sound, regardless of the app setting
set -euo pipefail

query=""
case "${1:-}" in
    "") ;;
    -s|--silent) query="?sound=0" ;;
    -S|--sound)  query="?sound=1" ;;
    -h|--help)
        sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
        exit 0 ;;
    *)
        echo "confetti: unknown option '$1'" >&2
        exit 2 ;;
esac

if ! open -g "confetti://fire$query" 2>/dev/null; then
    echo "confetti: the Confetti app is not installed (no handler for confetti:// URLs)." >&2
    echo "          Run ./build.sh --install from the repo, or launch /Applications/Confetti.app once." >&2
    exit 1
fi
